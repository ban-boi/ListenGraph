{
  "name": "listen-graphic",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:web": "turbo run dev --filter=web-demo",
    "dev:ext": "turbo run dev --filter=extension",
    "dev:ext:chrome": "pnpm --filter extension dev:chrome",
    "dev:desktop": "turbo run dev --filter=desktop",
    "ensure:electron": "pnpm --filter desktop ensure-electron",
    "dev:mock-asr-bridge": "node ./tools/mock-asr-bridge.mjs",
    "dev:sherpa-asr-bridge": "python ./tools/sherpa-onnx-bridge.py",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:ext:contract": "pnpm --filter extension test:contract",
    "test:ext:replay": "pnpm --filter extension test:structure",
    "test:ext:real-fixture:check": "pnpm --filter extension test:real-fixture:check",
    "test:ext:e2e": "pnpm --filter extension test:e2e",
    "test:ext:e2e:closure": "pnpm --filter extension exec playwright test e2e/extension.closure.spec.ts",
    "test:ext:e2e:real:local-bridge": "pnpm --filter extension test:e2e:real:local-bridge",
    "test:ext:e2e:real:sherpa": "pnpm --filter extension test:e2e:real:sherpa",
    "test:ext:asr:local-bridge": "pnpm --filter extension test:asr:local-bridge",
    "test:ext:asr:local-bridge:mock": "pnpm --filter extension test:asr:local-bridge:mock",
    "prepare:asr:local": "pnpm --filter extension prepare:asr:local",
    "prepare:structure:local-replay": "pnpm --filter extension prepare:structure:local-replay",
    "segment:asr:local": "pnpm --filter extension segment:asr:local",
    "compare:structure": "pnpm --filter extension compare:structure",
    "compare:structure:segments": "pnpm --filter extension compare:structure:segments",
    "judge:acceptance": "pnpm --filter extension judge:acceptance",
    "test:layout-lab": "pnpm --filter listen-graph-layout-lab test",
    "test:layout-regression": "pnpm --filter listen-graph-layout-lab run-regression -- --split regression",
    "test:layout-regression:holdout": "pnpm --filter listen-graph-layout-lab run-regression -- --split holdout",
    "test:r3b-release-gate": "pnpm --filter listen-graph-layout-lab release-gate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.7.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
