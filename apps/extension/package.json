{
  "name": "extension",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "prepare:asr:real": "node ./scripts/prepare-asr-realtime-fixtures.mjs",
    "prepare:structure:replay": "node ./scripts/prepare-structure-replay-fixtures.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:structure:mock": "vitest run src/service-worker/index.test.ts -t structure-focused",
    "test:structure:real": "vitest run src/service-worker/structure-focused.real.test.ts",
    "test:structure:real:smoke": "node ./scripts/run-structure-real.mjs smoke",
    "test:structure:real:full": "node ./scripts/run-structure-real.mjs full",
    "test:structure:real:full:part1": "node ./scripts/run-structure-real.mjs full-part1",
    "test:structure:real:full:part2": "node ./scripts/run-structure-real.mjs full-part2",
    "test:structure:real:replay": "node ./scripts/run-structure-real.mjs replay",
    "test:structure:real:replay:strict": "node ./scripts/run-structure-replay-strict.mjs",
    "test:structure:replay:no-assembler": "node ./scripts/run-structure-replay-strict.mjs --no-assembler",
    "test:structure:compare:baseline": "node ./scripts/compare-assembler-baseline.mjs",
    "test:structure:ws:kpi": "node ./scripts/report-structure-unit-ws-kpis.mjs",
    "test:structure:ws:kpi:compare": "node ./scripts/report-structure-unit-ws-kpis.mjs --compare",
    "test:structure": "pnpm run test:structure:mock && pnpm run test:structure:real:smoke",
    "test:structure:stable": "pnpm run test:structure:mock && pnpm run test:structure:real:smoke && pnpm run test:structure:real:replay:strict",
    "test:structure:full": "pnpm run test:structure:mock && pnpm run test:structure:real:full",
    "test:asr:real": "vitest run src/service-worker/asr-realtime.real.test.ts",
    "test:asr:compare": "vitest run src/service-worker/asr-transport-compare.real.test.ts",
    "test:asr:local-bridge": "vitest run src/service-worker/asr-realtime.local-bridge.test.ts",
    "test:asr:local-bridge:mock": "node ./scripts/run-asr-local-bridge-test.mjs",
    "test:real-fixture:check": "node ./scripts/check-real-e2e-fixture-baseline.mjs",
    "test:contract": "vitest run src/service-worker/index.test.ts",
    "test:e2e": "playwright test e2e/extension.local.spec.ts",
    "test:e2e:closure": "playwright test e2e/extension.closure.spec.ts",
    "test:e2e:headed": "playwright test e2e/extension.local.spec.ts --headed",
    "test:e2e:real": "playwright test e2e/extension.real.spec.ts",
    "test:e2e:real:local-bridge": "node ./scripts/run-e2e-real-local-bridge.mjs",
    "test:e2e:real:sherpa": "node ./scripts/run-e2e-real-sherpa.mjs",
    "test:e2e:full": "playwright test e2e/extension.local.spec.ts e2e/extension.closure.spec.ts e2e/extension.real.spec.ts"
  },
  "dependencies": {
    "@listen-graphic/domain": "workspace:*",
    "@listen-graphic/graph-renderers": "workspace:*",
    "@listen-graphic/providers": "workspace:*",
    "@listen-graphic/schema": "workspace:*",
    "@listen-graphic/storage": "workspace:*",
    "dagre": "^0.8.5",
    "dexie": "^4.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "reactflow": "^11.11.4",
    "webextension-polyfill": "^0.12.0",
    "zod": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.268",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^29.0.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  }
}
