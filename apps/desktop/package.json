{
  "name": "desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "ensure-electron": "node ./scripts/ensure-electron.mjs",
    "postinstall": "node ./scripts/ensure-electron.mjs",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint src electron",
    "test": "vitest run",
    "smoke": "pnpm run build && cross-env LISTEN_GRAPH_DESKTOP_SMOKE=1 electron ."
  },
  "dependencies": {
    "@listen-graphic/asr-runtime": "workspace:*",
    "@listen-graphic/domain": "workspace:*",
    "@listen-graphic/graph-renderers": "workspace:*",
    "@listen-graphic/providers": "workspace:*",
    "@listen-graphic/schema": "workspace:*",
    "@listen-graphic/ui": "workspace:*",
    "dagre": "^0.8.5",
    "dexie": "^4.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "reactflow": "^11.11.4",
    "zod": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "jsdom": "^29.0.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  }
}
